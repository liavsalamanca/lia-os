# Ruta base de publicación. Por defecto /lia-os/ (GitHub Pages).
# Usa / para servir la app desde la raíz de un dominio.
# VITE_BASE=/lia-os/

# Sincronización en la nube (opcional). Sin estos valores la app funciona solo en local.
# Usa únicamente la clave publishable (sb_publishable_...).
# Nunca escribas aquí una clave secreta o service_role: todo lo que empieza por VITE_ termina en el navegador.
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
